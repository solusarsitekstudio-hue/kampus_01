*.pyc
*.pyo
.vscode/
.idea/
*.log

# Backup & Workspace sementara (bukan bagian dari deliverable)
scratch/
data/_backup/

# Registry runtime engine input & output + sandbox test engine
data/engine/
data/engine_test_*/

